{
  "name": "flight-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config dev/proxy.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "fixtures": "node dev/fixtures.mjs",
    "test:search": "ng test --watch=false --include=src/app/domains/ticketing/flight-search.spec.ts",
    "sheriff": "sheriff verify src/main.ts",
    "test:count": "ng test --watch=false --include=src/app/domains/ticketing/flight-count.spec.ts",
    "check:tools": "tsc --project dev/tsconfig.json --noEmit",
    "scenario": "node dev/scenario-cli.mjs",
    "scenario:list": "node dev/inspect-scenario.mts list",
    "scenario:call": "node dev/inspect-scenario.mts call error_then_success"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ngrx/signals": "22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@softarc/sheriff-core": "0.20.0",
    "@types/node": "24.19.2",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "zod": "4.6.7"
  }
}
